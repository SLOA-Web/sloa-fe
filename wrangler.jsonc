{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sloa-fe",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API -- see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow fetching URLs in the app -- see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sloa-fe"
    }
  ],
  "images": {
    // next/image optimization via Cloudflare Images -- see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  }
}
